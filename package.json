{
  "name": "ursim-frc",
  "version": "0.1.0",
  "private": true,
  "description": "UrSim FRC Edition — FRC REBUILT 2026 driving simulator",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "convert:field": "node --max-old-space-size=8192 tools/convert-field.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "@types/node": "22.9.0",
    "@types/three": "0.170.0",
    "meshoptimizer": "^0.22.0",
    "occt-import-js": "^0.0.22",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
